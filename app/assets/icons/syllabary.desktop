[Desktop Entry]
Name=Syllabary
Comment=Fast, offline desktop word processor and PDF/DOCX studio
Exec=syllabary %F
Icon=syllabary
Terminal=false
Type=Application
Categories=Office;WordProcessor;
MimeType=application/x-syllabary;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;application/pdf;text/markdown;application/rtf;text/plain;
StartupWMClass=Syllabary
